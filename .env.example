PORT=5000

# Full URI for your PostgreSQL database or Shared Pooler (Supabase, Neon, Render, Railway, AWS RDS, etc.)
# Examples:
# Local: postgresql://postgres:password@localhost:5432/store_rating_db
# Supabase Pooler: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Neon Pooler: postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/store_rating_db

# Set to true for explicit SSL enforcement, or let it auto-detect from cloud URI
DATABASE_SSL=true

# Connection pool limits (recommended 5-10 for shared poolers / serverless)
DB_POOL_MAX=10

# Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple, or your Netlify app URL)
# Example: https://my-store-rating.netlify.app
FRONTEND_URL=http://localhost:5173

# Optional: Auto-run database migrations and admin seeding on server start
AUTO_MIGRATE=true

NODE_ENV=production
